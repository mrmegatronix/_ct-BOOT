[Unit]
Description=Auto-mount KIOSKDATA USB Partition
DefaultDependencies=no
After=local-fs-pre.target
Before=local-fs.target kiosk.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /mnt/kiosk-data && mount -L KIOSKDATA /mnt/kiosk-data -o ro,nofail,umask=022 || true'

[Install]
WantedBy=multi-user.target

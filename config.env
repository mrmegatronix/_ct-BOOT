# USB Web Kiosk Build Configuration
DISTRO="debian"
DEBIAN_CODENAME="bookworm"
ARCH="amd64"
OUTPUT_DIR="output"
ISO_NAME="web-kiosk-live.iso"
VOLUME_ID="WEB_KIOSK"
CONTENT_PART_LABEL="KIOSKDATA"

# Kiosk Display Settings
RESOLUTION="1920x1080"
KIOSK_USER="kiosk"
LOCAL_SERVER_PORT="8080"
DEFAULT_TARGET_URL="http://localhost:8080/index.html"

# Browser Options
BROWSER="chromium"
BROWSER_FLAGS="--kiosk --noerrdialogs --disable-infobars --no-first-run --fast --fast-start --disable-pinch --overscroll-history-navigation=0 --check-for-update-interval=31536000 --disable-session-crashed-bubble --disable-features=TranslateUI --autoplay-policy=no-user-gesture-required --simulate-outdated-no-au='Tue, 31 Dec 2099 23:59:59 GMT'"
